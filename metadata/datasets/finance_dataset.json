"ai_context": {
    "summary": "This dataset contains financial, billing, insurance and revenue analytics related to patient admissions. It should be used for answering questions about hospital revenue, payment performance, insurance coverage, billing analysis and departmental financial performance.",

    "preferred_metrics": [
        "total_amount",
        "department_total_revenue",
        "average_revenue",
        "insurance_covered_amount",
        "patient_payable_amount",
        "payment_completion_ratio",
        "insurance_coverage_percentage"
    ],

    "preferred_dimensions": [
        "department_name",
        "bill_date",
        "payment_status",
        "payment_mode",
        "insurance_tier",
        "revenue_band",
        "financial_risk"
    ],

    "business_goal": "Analyze hospital financial performance, monitor revenue trends, evaluate insurance utilization and improve payment collection efficiency."
},
