"metrics": [
    {
        "name": "total_amount",
        "display_name": "Total Revenue",
        "description": "Total billed amount.",
        "datatype": "REAL",
        "default_aggregation": "SUM",
        "unit": "INR",
        "aliases": ["revenue", "income", "billing", "sales"],
        "display_format": "currency",
        "search_weight": 100,
        "sortable": true
    },
    {
        "name": "insurance_covered_amount",
        "display_name": "Insurance Coverage Amount",
        "description": "Amount covered by insurance.",
        "datatype": "REAL",
        "default_aggregation": "SUM",
        "unit": "INR",
        "aliases": ["covered amount", "insurance payment"],
        "display_format": "currency",
        "search_weight": 95,
        "sortable": true
    },
    {
        "name": "patient_payable_amount",
        "display_name": "Patient Payable Amount",
        "description": "Amount payable by the patient.",
        "datatype": "REAL",
        "default_aggregation": "SUM",
        "unit": "INR",
        "aliases": ["patient payment", "self pay"],
        "display_format": "currency",
        "search_weight": 95,
        "sortable": true
    },
    {
        "name": "average_revenue",
        "display_name": "Average Revenue",
        "description": "Average revenue generated per billing record.",
        "datatype": "REAL",
        "default_aggregation": "AVG",
        "unit": "INR",
        "aliases": ["avg revenue", "average billing"],
        "display_format": "currency",
        "search_weight": 90,
        "sortable": true
    },
    {
        "name": "department_total_revenue",
