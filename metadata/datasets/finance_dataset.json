        "display_format": "currency",
        "search_weight": 95,
        "sortable": true
    },
    {
        "name": "payment_completion_ratio",
        "display_name": "Payment Completion Ratio",
        "description": "Percentage of completed payments.",
        "datatype": "REAL",
        "default_aggregation": "AVG",
        "unit": "%",
        "aliases": ["payment ratio", "completion rate"],
        "display_format": "percentage",
        "search_weight": 90,
        "sortable": true
    },
    {
        "name": "insurance_coverage_percentage",
        "display_name": "Insurance Coverage Percentage",
        "description": "Percentage of bill covered by insurance.",
        "datatype": "REAL",
        "default_aggregation": "AVG",
        "unit": "%",
        "aliases": ["coverage percentage", "insurance percent"],
        "display_format": "percentage",
        "search_weight": 90,
        "sortable": true
    },
    {
        "name": "patient_payment_percentage",
        "display_name": "Patient Payment Percentage",
        "description": "Percentage of bill paid by the patient.",
        "datatype": "REAL",
        "default_aggregation": "AVG",
        "unit": "%",
        "aliases": ["patient contribution", "self pay percentage"],
        "display_format": "percentage",
        "search_weight": 85,
        "sortable": true
    },
    {
        "name": "revenue_per_day",
        "display_name": "Revenue Per Day",
        "description": "Average revenue generated per hospital stay day.",
        "datatype": "REAL",
        "default_aggregation": "AVG",
        "unit": "INR",
        "aliases": ["daily revenue"],
        "display_format": "currency",
        "search_weight": 85,
        "sortable": true
    },
    {
        "name": "department_revenue_share",
        "display_name": "Department Revenue Share",
        "description": "Percentage contribution of a department to total revenue.",
        "datatype": "REAL",
        "default_aggregation": "AVG",
        "unit": "%",
        "aliases": ["department contribution", "revenue share"],
        "display_format": "percentage",
        "search_weight": 85,
        "sortable": true
    }
],
