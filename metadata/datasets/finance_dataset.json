            "remote_column": "admission_id",
            "relationship": "one_to_one"
        },
        {
            "dataset": "operations",
            "local_column": "department_id",
            "remote_column": "department_id",
            "relationship": "many_to_one"
        },
        {
            "dataset": "medical",
            "local_column": "disease_id",
            "remote_column": "disease_id",
            "relationship": "many_to_one"
        }
    ]
},
