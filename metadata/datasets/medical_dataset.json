{

"dataset_info": {
    "id": "medical",
    "name": "Medical Analytics",
    "description": "Clinical analytics covering diseases, diagnostics, laboratory tests, prescriptions, medications and doctor performance.",
    "table": "gold_medical_analytics",
    "table_type": "gold",
    "grain": "One record per patient admission with associated clinical activities",
    "primary_key": "patient_diagnostic_id",
    "owner": "MedIntel360",
    "version": "1.0.0"
},

"physical_schema": {
    "columns": [
        "admission_id",
        "patient_id",
        "department_id_x",
        "ward_id",
        "bed_id",
        "disease_id",
